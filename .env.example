# Banco de Dados
# Deixe em branco para usar SQLite local (sem sincronização entre dispositivos)
# 
# Para PostgreSQL (Neon, Supabase, etc):
# DATABASE_URL=postgresql://user:password@host:5432/database
#
# Para MySQL/TiDB Cloud:
# DATABASE_URL=mysql://user:password@host:3306/database
#
# Para TiDB Cloud Serverless:
# DATABASE_URL=mysql://root:password@gateway01.us-west-2.prod.aws.tidbcloud.com:4000/database?sslMode=require

DATABASE_URL=

# Ambiente
NODE_ENV=production
PORT=3000
